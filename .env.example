# Daymate local development environment.
# Copy to `.env` and fill in. NEVER commit real secrets.
# Spec §17: tokens and authorization codes never enter model context or logs.

# ── Model adapter (pi-ai) ───────────────────────────────────────────────────
# Used from Milestone 1 onward.
DAYMATE_MODEL_PROVIDER=anthropic
DAYMATE_MODEL_NAME=claude-sonnet-5
DAYMATE_MODEL_API_KEY=

# ── Gmail OAuth (Milestone 2) ───────────────────────────────────────────────
# Google Cloud project → OAuth 2.0 Desktop app. Scopes requested incrementally.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── 163 Mail (Milestone 2) ─────────────────────────────────────────────────
# Use client authorization code, not mailbox password.
MAIL163_HOST=imap.163.com
MAIL163_PORT=993
MAIL163_SMTP_HOST=smtp.163.com
MAIL163_SMTP_PORT=465
MAIL163_USER=
MAIL163_AUTH_CODE=

# ── Feishu (Milestone 3) ────────────────────────────────────────────────────
# Personal test tenant only. Never connect company production data.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
