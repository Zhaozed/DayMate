[Unit]
Description=Daymate Personal Agent Headless Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/daymate
Environment=PORT=3210
Environment=HOST=0.0.0.0
Environment=DAYMATE_DATA_DIR=/opt/daymate/data
EnvironmentFile=-/opt/daymate/.env
ExecStart=/usr/bin/node /opt/daymate/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
