# ==============================================================================
# Daymate Desktop Client Configuration (Connecting to Remote Server)
# ==============================================================================

# Remote Server URL (e.g. Tailscale IP or public server IP + port)
DAYMATE_SERVER_URL=http://127.0.0.1:3210
# Or with Tailscale:
# DAYMATE_SERVER_URL=http://100.x.y.z:3210

# Pre-Shared Authentication Token (Must match DAYMATE_SERVER_TOKEN on the server)
DAYMATE_SERVER_TOKEN=your-random-strong-secret-token-here

# Note: If DAYMATE_SERVER_URL is left empty or commented out, Daymate operates in
# standard standalone local mode (local SQLite & local execution).
