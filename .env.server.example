# ==============================================================================
# Daymate Server Configuration (for Alibaba Cloud Linux / ECS)
# ==============================================================================

# Server Network & Port
PORT=3210
HOST=0.0.0.0

# Pre-Shared Authentication Token (Keep this secret! Your desktop client must use this same token)
DAYMATE_SERVER_TOKEN=your-random-strong-secret-token-here

# Server Master Secret Key (Used for encrypting LLM keys, Gmail tokens, and 163 passwords at rest)
DAYMATE_SECRET_KEY=generate-a-secure-random-string-at-least-32-chars-long

# Persistent Data Directory (Where SQLite daymate.db, settings.json, secrets.json are stored)
DAYMATE_DATA_DIR=/var/lib/daymate

# Local Proxy Setting (Required for domestic ECS to access Google/Gmail API)
# If you run Clash / Xray / Sing-box on your server listening on 127.0.0.1:7890:
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# If deploying on an overseas server (e.g. Hong Kong / Singapore ECS), you can comment out the PROXY lines:
# HTTPS_PROXY=
# HTTP_PROXY=
